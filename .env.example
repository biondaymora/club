# Public Supabase settings
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000
# preview (default) shows the visual demo and pauses all real mutations; live requires the full rollout checklist
NEXT_PUBLIC_CLUB_MODE=preview

# Server-only credentials — never prefix these with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=
SHOPIFY_STORE_DOMAIN=
SHOPIFY_ADMIN_ACCESS_TOKEN=
SHOPIFY_WEBHOOK_SECRET=
OMNISEND_API_KEY=
OMNISEND_API_VERSION=2026-03-15
SENTRY_DSN=
CRON_SECRET=
